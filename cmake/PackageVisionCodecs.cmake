# Offline Linux candidate bundle. Build/distribution glue, not a deployment recipe.
# cmake -DINPUT_BIN_DIR=... -DCODEC_PREFIX=... -DSOURCE_CACHE=...
#       -DOUTPUT_DIR=... -P cmake/PackageVisionCodecs.cmake
cmake_minimum_required(VERSION 3.22)
get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
foreach(_arg INPUT_BIN_DIR CODEC_PREFIX SOURCE_CACHE OUTPUT_DIR)
  if(NOT DEFINED ${_arg} OR "${${_arg}}" STREQUAL "")
    message(FATAL_ERROR "Required: ${_arg}")
  endif()
  get_filename_component(${_arg} "${${_arg}}" ABSOLUTE)
endforeach()
if(EXISTS "${OUTPUT_DIR}")
  message(FATAL_ERROR "OUTPUT_DIR must not exist; never overwrite an artifact")
endif()
# Check the exact evaluated shared-library files and complete corresponding source
# before creating output. No fallback to arbitrary installed libraries or downloads.
file(STRINGS "${_root}/third_party/vision-codecs/RUNTIME.sha256" _runtime)
foreach(_line IN LISTS _runtime)
  string(REGEX MATCH "^([0-9a-f]+)  ([A-Za-z0-9_.-]+)$" _match "${_line}")
  if(NOT _match)
    message(FATAL_ERROR "Invalid runtime manifest")
  endif()
  set(_expected "${CMAKE_MATCH_1}")
  set(_name "${CMAKE_MATCH_2}")
  file(SHA256 "${CODEC_PREFIX}/lib/x86_64-linux-gnu/${_name}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Runtime library does not match evaluated artifact: ${_name}")
  endif()
  list(APPEND _files "${_name}")
endforeach()
file(STRINGS "${_root}/third_party/vision-codecs/ARTIFACTS.sha256" _artifacts)
foreach(_line IN LISTS _artifacts)
  if(_line MATCHES "^([0-9a-f]+)  source/([A-Za-z0-9_.+-]+)$")
    set(_expected "${CMAKE_MATCH_1}")
    set(_name "${CMAKE_MATCH_2}")
    file(SHA256 "${SOURCE_CACHE}/${_name}" _actual)
    if(NOT _actual STREQUAL _expected)
      message(FATAL_ERROR "Corresponding source mismatch: ${_name}")
    endif()
    list(APPEND _sources "${_name}")
  endif()
endforeach()
list(LENGTH _sources _source_count)
if(NOT _source_count EQUAL 3)
  message(FATAL_ERROR "Require original source, exact distro changes/build files and dsc")
endif()
foreach(_bin unbiased-strata strata-vision-reader strata-process-guard)
  if(NOT EXISTS "${INPUT_BIN_DIR}/${_bin}" OR IS_DIRECTORY "${INPUT_BIN_DIR}/${_bin}")
    message(FATAL_ERROR "Missing candidate executable: ${_bin}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${OUTPUT_DIR}/bin" "${OUTPUT_DIR}/lib" "${OUTPUT_DIR}/share/vision-codecs/source")
foreach(_bin unbiased-strata strata-vision-reader strata-process-guard)
  file(COPY "${INPUT_BIN_DIR}/${_bin}" DESTINATION "${OUTPUT_DIR}/bin")
endforeach()
foreach(_name IN LISTS _files)
  file(COPY_FILE "${CODEC_PREFIX}/lib/x86_64-linux-gnu/${_name}" "${OUTPUT_DIR}/lib/${_name}")
  string(REGEX REPLACE "(\\.so\\.[0-9]+)\\..*$" "\\1" _soname "${_name}")
  file(CREATE_LINK "${_name}" "${OUTPUT_DIR}/lib/${_soname}" SYMBOLIC)
endforeach()
foreach(_name IN LISTS _sources)
  file(COPY_FILE "${SOURCE_CACHE}/${_name}" "${OUTPUT_DIR}/share/vision-codecs/source/${_name}")
endforeach()
file(COPY "${_root}/third_party/vision-codecs/licenses" DESTINATION "${OUTPUT_DIR}/share/vision-codecs")
foreach(_name NOTICE.md ARTIFACTS.sha256 RUNTIME.sha256)
  file(COPY_FILE "${_root}/third_party/vision-codecs/${_name}" "${OUTPUT_DIR}/share/vision-codecs/${_name}")
endforeach()
file(COPY_FILE "${_root}/LICENSE" "${OUTPUT_DIR}/share/APPLICATION-LICENSE")
file(COPY_FILE "${_root}/docs/vision-native-status.md" "${OUTPUT_DIR}/share/vision-codecs/STATUS.md")
file(GLOB_RECURSE _contents LIST_DIRECTORIES false RELATIVE "${OUTPUT_DIR}" "${OUTPUT_DIR}/*")
list(SORT _contents)
set(_manifest "")
foreach(_file IN LISTS _contents)
  file(SHA256 "${OUTPUT_DIR}/${_file}" _sha)
  string(APPEND _manifest "${_sha}  ${_file}\n")
endforeach()
file(WRITE "${OUTPUT_DIR}/BUNDLE.sha256" "${_manifest}")
message(STATUS "PR6 candidate bundle created; codec compliance requires the documented verification. Not deployment approval.")
