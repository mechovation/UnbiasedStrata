# Installed, unmodified OSS libraries only. No FetchContent or source patches.
function(strata_vision_codecs)
  find_path(STRATA_IMAGE_WEBP_INCLUDE NAMES webp/demux.h REQUIRED)
  find_path(STRATA_IMAGE_EXIF_INCLUDE NAMES libexif/exif-data.h REQUIRED)
  find_path(STRATA_IMAGE_YUV_INCLUDE NAMES libyuv.h REQUIRED)
  # A replaceable shared LGPL library is mandatory, even with BUILD_SHARED_LIBS=OFF.
  set(CMAKE_FIND_LIBRARY_SUFFIXES "${CMAKE_SHARED_LIBRARY_SUFFIX}")
  foreach(_name webp webpdemux exif yuv)
    string(TOUPPER "${_name}" _upper)
    find_library(STRATA_IMAGE_${_upper}_LIBRARY NAMES ${_name} REQUIRED)
    get_filename_component(_real "${STRATA_IMAGE_${_upper}_LIBRARY}" REALPATH)
    if(NOT _real MATCHES "\\.so(\\.[0-9]+)*$|\\.dylib$")
      message(FATAL_ERROR "PR6 image libraries must be replaceable shared libraries, not static archives")
    endif()
    list(APPEND _libraries "${STRATA_IMAGE_${_upper}_LIBRARY}")
  endforeach()
  add_library(strata_vision_image STATIC "${PROJECT_SOURCE_DIR}/frontend/vision_image.cpp")
  target_include_directories(strata_vision_image PUBLIC "${PROJECT_SOURCE_DIR}/frontend"
    "${STRATA_IMAGE_WEBP_INCLUDE}" "${STRATA_IMAGE_EXIF_INCLUDE}" "${STRATA_IMAGE_YUV_INCLUDE}")
  target_include_directories(strata_vision_image PRIVATE "${STRATA_GGML_DIR}")
  target_link_libraries(strata_vision_image PUBLIC ${_libraries} ${CMAKE_DL_LIBS})
  target_compile_features(strata_vision_image PUBLIC cxx_std_20)
  target_compile_definitions(strata_vision_image PRIVATE _GNU_SOURCE)
endfunction()
strata_vision_codecs()
